# Paste into config/theme/templates.toml (r2-d2).
# Paths are relative to config/theme/, same as the walker and gtk entries.
# Output lands at config/den-den-mushi/style.css inside the r2-d2 repo.
# r2-d2-theme-sync-live does not copy new outputs on its own; see README.md.

[templates.den-den-mushi]
input_path = "templates/den-den-mushi.css"
output_path = "../den-den-mushi/style.css"
